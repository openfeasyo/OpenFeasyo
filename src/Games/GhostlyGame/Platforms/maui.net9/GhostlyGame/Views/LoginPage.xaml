<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ghostlyGame="clr-namespace:GhostlyGame"
             x:Class="GhostlyGame.Views.LoginPage"
             Title=""
             BackgroundImageSource="menu_background.png">
    <VerticalStackLayout VerticalOptions="Center">
        <Label x:Name="Title"
               Text="Ghostly"
               TextColor="#0BCEC4"
               VerticalOptions="Center" 
               HorizontalOptions="Center"
               FontSize="120"
               FontFamily="Vitamin"
               Padding="10,40,10,20"/>

        <Entry x:Name="username"
               Placeholder="{Binding LocalizationResourceManager[EnterUsername], Mode=OneWay}"
               PlaceholderColor="#393939"
               Text="{Binding Username}"
               FontSize="25"/>

        <Entry x:Name="password"
               Placeholder="{Binding LocalizationResourceManager[EnterPassword], Mode=OneWay}"
               PlaceholderColor="#393939"
               IsPassword="True"
               Text="{Binding Password}"
               FontSize="25"/>

        <Button
            x:Name="LoginBtn"
            Text="{Binding LocalizationResourceManager[LogIn], Mode=OneWay}" 
            Clicked="OnLoginClicked"
            HorizontalOptions="Fill"
            BackgroundColor="#0BCEC4"
            TextColor="White"
            FontFamily="Vitamin"
            FontSize="Large"/>

        <Label 
            x:Name="ErrorMsg"
            Text=""
            TextColor="Red"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="Large"
            Padding="10,40,10,20"/>

        <Button
            x:Name="InstructionVideoBtn"
            Text="{Binding LocalizationResourceManager[WatchInstructions], Mode=OneWay}" 
            Clicked="OnInstructionVideoClicked"
            HorizontalOptions="Center"
            BackgroundColor="#0BCEC4"
            TextColor="White"
            FontFamily="Vitamin"
            FontSize="Large"
            Padding="20"/>

        <HorizontalStackLayout HorizontalOptions="End">
            <Button
                x:Name="FR_lang"
                Text="FR"
                Clicked="OnFR_langClicked"
                HorizontalOptions="Center"
                Background="#0BCEC4"
                TextColor="White"
                FontFamily="Vitamin"
                FontSize="Small"
                Padding="10"/>

            <Button
                x:Name="NL_lang"
                Text="NL"
                Clicked="OnNL_langClicked"
                HorizontalOptions="Center"
                Background="#0BCEC4"
                TextColor="White"
                FontFamily="Vitamin"
                FontSize="Small"
                Padding="10"/>

            <Button
                x:Name="EN_lang"
                Text="EN"
                Clicked="OnEN_langClicked"
                HorizontalOptions="Center"
                Background="#0BCEC4"
                TextColor="White"
                FontFamily="Vitamin"
                FontSize="Small"
                Padding="10"/>
            
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>