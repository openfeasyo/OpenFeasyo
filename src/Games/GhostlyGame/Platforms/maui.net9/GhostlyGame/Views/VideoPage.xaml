<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:GhostlyGame"
             x:Class="GhostlyGame.Views.VideoPage"
             BackgroundImageSource="menu_background.png"
             Title="">
    <VerticalStackLayout>
        <Label 
            Text="{Binding LocalizationResourceManager[HowToUse], Mode=OneWay}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            TextColor="#0BCEC4"
            FontSize="50"
            FontFamily="Vitamin"
            Padding="0"/>


        <!--<Image Source="menu_background.png"  WidthRequest="100" HeightRequest="100" Aspect="AspectFit">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPlayVideoTapped"/>
            </Image.GestureRecognizers>
        </Image> -->

        <!--<Label x:Name="statusLabel"
               Text="Loading video..."
               HorizontalOptions="Center" />-->

        <toolkit:MediaElement x:Name="mediaPlayer"
                              HeightRequest="500"
                              WidthRequest="900"
                              ShouldShowPlaybackControls="True"
                              ShouldAutoPlay="True"
                              ShouldKeepScreenOn="True"
                              Aspect="AspectFit"
                              IsVisible="False"/>
        
        <!-- ShowsPlaybackControls="True" -->

        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
            <Button Text="{Binding LocalizationResourceManager[BfrBandsVideo], Mode=OneWay}" 
                    Clicked="OnBfrBandsVideo"
                    HorizontalOptions="Center"
                    Background="#0BCEC4"
                    TextColor="White"
                    FontFamily="Vitamin"
                    FontSize="Large"
                    Margin="10"/>

            <Button Text="{Binding LocalizationResourceManager[BfrAppVideo], Mode=OneWay}" 
                    Clicked="OnBfrAppVideo"
                    HorizontalOptions="Center"
                    Background="#0BCEC4"
                    TextColor="White"
                    FontFamily="Vitamin"
                    FontSize="Large"
                    Margin="10"/>

            <Button Text="{Binding LocalizationResourceManager[EmgSensorsVideo], Mode=OneWay}" 
                    Clicked="OnEmgVideo"
                    HorizontalOptions="Center"
                    Background="#0BCEC4"
                    TextColor="White"
                    FontFamily="Vitamin"
                    FontSize="Large"
                    Margin="10"/>
        </HorizontalStackLayout>

        <!-- <Button x:Name="WatchOnline"
                Text="{Binding LocalizationResourceManager[WatchOnline], Mode=OneWay}"
                Clicked="OnWatchOnline"
                HorizontalOptions="Center"
                Background="#0BCEC4"
                TextColor="White"
                FontFamily="Vitamin"
                FontSize="Large"
                Margin="10"/> -->

        <!--<Button
            x:Name="OkBtn"
            Text="{Binding LocalizationResourceManager[Back], Mode=OneWay}" 
            Clicked="OnOKClicked"
            HorizontalOptions="Center"
            BackgroundColor="#0BCEC4"
            TextColor="White"
            FontFamily="Vitamin"
            FontSize="Large"
            Margin="10"/> -->

    </VerticalStackLayout>
</ContentPage>