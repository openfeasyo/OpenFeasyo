<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GhostlyGame.Views.VideoPage"
             BackgroundImageSource="menu_background.png"
             Title="">
    <VerticalStackLayout>
        <Label 
            Text="How to play Ghostly+ Game"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            TextColor="#0BCEC4"
            FontSize="60"
            FontFamily="Vitamin"
            Padding="10,40,10,20"/>

        <WebView BackgroundColor="Yellow"
                 WidthRequest="600"
                 HeightRequest="400"
                 Source="https://www.youtube.com/embed/uf3yFalBmOw"
                 Margin="20,20,20,20"/>

        <Button
            x:Name="OkBtn"
            Text="OK" 
            Clicked="OnOKClicked"
            HorizontalOptions="Center"
            BackgroundColor="#0BCEC4"
            TextColor="White"
            FontFamily="Vitamin"
            FontSize="Large"/>

    </VerticalStackLayout>
</ContentPage>